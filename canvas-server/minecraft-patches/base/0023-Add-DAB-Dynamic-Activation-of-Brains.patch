From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RevAnjay <rysffpro1@gmail.com>
Date: Tue, 28 Jul 2026 22:00:21 +0700
Subject: [PATCH] Add DAB (Dynamic Activation of Brains)


diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index e22bd0f080fa2de8b17aa4d79e1228e7cfa16fdd..4e7b4b91f5b7f982419016b1c5210861d68be1c3 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -173,7 +173,7 @@ public final class ActivationRange {
                     continue;
                 }
 
-                ActivationRange.activateEntity(entity, bbByType); // Folia - threaded regions
+                ActivationRange.activateEntity(entity, bbByType, player); // Folia - threaded regions
             }
         }
     }
@@ -183,7 +183,7 @@ public final class ActivationRange {
      *
      * @param entity
      */
-    private static void activateEntity(final Entity entity, final AABB[] bbByType) { // Folia - threaded regions
+    private static void activateEntity(final Entity entity, final AABB[] bbByType, final net.minecraft.world.entity.player.Player player) { // Folia - threaded regions
         if (io.papermc.paper.threadedregions.RegionizedServer.getCurrentTick() > entity.activatedTick) { // Folia - threaded regions
             if (entity.defaultActivationState) {
                 entity.activatedTick = io.papermc.paper.threadedregions.RegionizedServer.getCurrentTick(); // Folia - threaded regions
@@ -191,6 +191,21 @@ public final class ActivationRange {
             }
             if (bbByType[entity.activationType.ordinal()].intersects(entity.getBoundingBox())) { // Folia - threaded regions
                 entity.activatedTick = io.papermc.paper.threadedregions.RegionizedServer.getCurrentTick(); // Folia - threaded regions
+                // Pufferfish start - DAB
+                if (io.canvasmc.canvas.GlobalConfiguration.getInstance().dab.enabled && entity.getType().dabEnabled &&
+                    (!entity.isInWater() || entity.getType().is(net.minecraft.tags.EntityTypeTags.CAN_BREATHE_UNDER_WATER))) {
+                    if (!entity.activatedPriorityReset) {
+                        entity.activatedPriorityReset = true;
+                        entity.activatedPriority = io.canvasmc.canvas.GlobalConfiguration.getInstance().dab.maxTickFreq;
+                    }
+                    int squaredDistance = (int) player.distanceToSqr(entity);
+                    entity.activatedPriority = squaredDistance > io.canvasmc.canvas.util.DABConfig.startDistanceSquared ?
+                      Math.max(1, Math.min(squaredDistance >> io.canvasmc.canvas.GlobalConfiguration.getInstance().dab.activationDistMod, entity.activatedPriority)) :
+                      1;
+                } else {
+                    entity.activatedPriority = 1;
+                }
+                // Pufferfish end
             }
         }
     }
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 899bb59d03ffd8d3bece3bec33c52d200eb56d31..e56e5971069560970342dc7ec909e854f7d3bde0 100644
